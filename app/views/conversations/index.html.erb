<article class="sheet">
  <header class="sheet-head sheet-head-row">
    <div>
      <h1>Conversations</h1>
      <% if @conversations.any? %>
        <p><%= pluralize(@conversations.size, "conversation") %></p>
      <% end %>
    </div>
    <%= link_to "New conversation", new_conversation_path, class: "btn" %>
  </header>

  <ul class="thread">
    <% if @conversations.empty? %>
      <li class="thread-empty">No conversations yet. Start one with "New conversation".</li>
    <% end %>
    <% @conversations.each do |conversation| %>
      <li class="convo">
        <p class="note"><%= conversation.updated_at.strftime("%b %d, %Y %H:%M") %></p>
        <div>
          <%= link_to conversation.title, conversation_path(conversation), class: "convo-title" %>
          <span class="stamp"><%= pluralize(@message_counts.fetch(conversation.id, 0), "message") %></span>
          <%= button_to "Delete", conversation_path(conversation), method: :delete, class: "convo-delete",
                data: { turbo_confirm: "Delete this conversation and its messages? This cannot be undone." } %>
        </div>
      </li>
    <% end %>
  </ul>
</article>
