<%= link_to "← Back to conversations", conversations_path, class: "text-cyan-400 hover:underline mb-4 inline-block" %>

<div class="bg-gray-800 border border-gray-700 rounded-lg p-4 mb-6">
  <h1 class="text-xl font-bold text-gray-100"><%= @conversation.title %></h1>
  <p class="text-sm text-gray-400"><%= @messages.count %> messages</p>
</div>

<%= turbo_stream_from @conversation %>

<div id="messages" class="space-y-4 mb-6" data-controller="streaming">
  <% @messages.each do |message| %>
    <%= render partial: "messages/message", locals: { message: message } %>
  <% end %>
</div>

<%= form_with model: @message, url: conversation_messages_path(@conversation), data: { action: "submit->streaming#submit" }, class: "bg-gray-800 border border-gray-700 rounded-lg p-4" do |f| %>
  <div class="mb-3">
    <%= f.text_area :content, rows: 3, placeholder: "Ask me anything...", class: "bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 w-full text-gray-100", autofocus: true, data: { streaming_target: "input" } %>
  </div>
  <%= f.submit "Send", class: "bg-cyan-600 text-white px-6 py-2 rounded-lg hover:bg-cyan-700 cursor-pointer", data: { streaming_target: "submit" } %>
<% end %>
