<%= link_to "← Back to conversations", conversations_path, class: "text-gray-400 hover:text-gray-100 mb-4 inline-block" %>

<article class="sheet">
  <header class="sheet-head">
    <h1><%= @conversation.title %></h1>
    <p><%= pluralize(@messages.count, "message") %></p>
  </header>

  <%= turbo_stream_from @conversation %>

  <div id="messages" class="thread" data-controller="streaming">
    <% if @messages.empty? %>
      <p class="thread-empty">No messages yet. Type below and the reply appears here.</p>
    <% end %>
    <% @messages.each do |message| %>
      <%= render partial: "messages/message", locals: { message: message } %>
    <% end %>
  </div>

  <%= form_with model: @message, url: conversation_messages_path(@conversation), data: { action: "submit->streaming#submit" }, class: "composer" do |f| %>
    <%= f.label :content, "Your message", class: "sr-only" %>
    <%= f.text_area :content, rows: 3, placeholder: "Describe what to write, or paste text to rewrite", autofocus: true, data: { streaming_target: "input" } %>
    <%= f.submit "Send", data: { streaming_target: "submit" } %>
  <% end %>
</article>
