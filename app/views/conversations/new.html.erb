<article class="sheet auth">
  <header class="sheet-head">
    <h1>New conversation</h1>
    <p>Give it a title so you can find it later.</p>
  </header>

  <%= form_with url: conversations_path, class: "auth-form" do |f| %>
    <div class="field">
      <%= f.label :title, "Title" %>
      <%= f.text_field :title, placeholder: "Blog post ideas", autofocus: true, required: true %>
    </div>
    <%= f.submit "Start conversation" %>
  <% end %>

  <footer class="auth-links">
    <p><%= link_to "Back to conversations", conversations_path %></p>
  </footer>
</article>
