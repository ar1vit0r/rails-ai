<%# Placement is driven by data-role: user messages go in the margin, replies in the text column (see .thread in application.css). %>
<div id="message_<%= message.id %>" class="msg" data-role="<%= message.role %>">
  <% if message.role == "user" %>
    <span class="sr-only">You:</span>
    <% if message.content.to_s.length > 240 %>
      <details class="note">
        <summary>
          <span class="closed"><%= truncate(message.content, length: 240) %></span>
          <span class="toggle"></span>
        </summary>
        <p><%= message.content %></p>
      </details>
    <% else %>
      <p class="note"><%= message.content %></p>
    <% end %>
  <% else %>
    <span class="sr-only">Assistant:</span>
    <p class="reply"><%= message.content %></p>
  <% end %>
  <time class="stamp" datetime="<%= message.created_at.iso8601 %>"><%= message.created_at.strftime("%H:%M") %></time>
</div>
