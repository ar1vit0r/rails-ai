<div id="message_<%= message.id %>" class="<%= message.role == 'user' ? 'bg-cyan-900/30 border-cyan-700' : 'bg-gray-800 border-gray-700' %> border rounded-lg p-4">
  <div class="flex items-center gap-2 mb-2">
    <span class="font-medium <%= message.role == 'user' ? 'text-cyan-400' : 'text-green-400' %>">
      <%= message.role == 'user' ? 'You' : 'AI' %>
    </span>
    <span class="text-xs text-gray-500"><%= message.created_at.strftime("%H:%M") %></span>
  </div>
  <p class="text-gray-200 whitespace-pre-wrap"><%= message.content %></p>
</div>
