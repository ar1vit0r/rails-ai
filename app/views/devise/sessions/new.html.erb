<div class="max-w-md mx-auto">
  <h2 class="text-2xl font-bold text-gray-100 mb-6">Log in</h2>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
    <div>
      <%= f.label :email, class: "block text-sm font-medium text-gray-300" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "bg-gray-800 border border-gray-700 rounded-lg px-4 py-2 w-full text-gray-100" %>
    </div>
    <div>
      <%= f.label :password, class: "block text-sm font-medium text-gray-300" %>
      <%= f.password_field :password, autocomplete: "current-password", class: "bg-gray-800 border border-gray-700 rounded-lg px-4 py-2 w-full text-gray-100" %>
    </div>
    <% if devise_mapping.rememberable? %>
      <div class="flex items-center gap-2">
        <%= f.check_box :remember_me, class: "rounded" %>
        <%= f.label :remember_me, class: "text-sm text-gray-400" %>
      </div>
    <% end %>
    <%= f.submit "Log in", class: "bg-cyan-600 text-white px-6 py-2 rounded-lg hover:bg-cyan-700 cursor-pointer w-full" %>
  <% end %>
  <div class="mt-4 text-sm text-gray-400 space-y-1">
    <%= link_to "Sign up", new_registration_path(resource_name), class: "text-cyan-400 hover:underline" %>
    <br>
    <%= link_to "Forgot your password?", new_password_path(resource_name), class: "text-cyan-400 hover:underline" %>
  </div>
</div>
