<article class="sheet auth">
  <header class="sheet-head">
    <h1>Choose a new password</h1>
    <p>You'll be logged in once it's saved.</p>
  </header>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "auth-form" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>
    <div class="field">
      <%= f.label :password, "New password" %>
      <%= f.password_field :password, autofocus: true, autocomplete: "new-password", aria: { describedby: ("password-hint" if @minimum_password_length) } %>
      <% if @minimum_password_length %>
        <span class="hint" id="password-hint"><%= @minimum_password_length %> characters minimum</span>
      <% end %>
    </div>
    <div class="field">
      <%= f.label :password_confirmation, "Confirm password" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
    </div>
    <%= f.submit "Change password" %>
  <% end %>
</article>
